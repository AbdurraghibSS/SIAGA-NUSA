# Salin menjadi .env · copy to .env
DATABASE_URL=postgresql+psycopg://siaga:siaga_dev@localhost:5434/siaga_nusa
POSTGRES_PASSWORD=siaga_dev
DB_PORT=5434

# Branch tempat GitHub Actions menyimpan snapshot prakiraan
SNAPSHOT_REMOTE=origin
SNAPSHOT_BRANCH=data-snapshots

# Pengamanan API (api/security.py). Header X-API-Key: wajib untuk /api/admin (kosong = admin mati),
# opsional di endpoint lain untuk klien tepercaya (bebas batas per IP). Buat: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
API_RATE_PER_MIN=120      # request /api/* per menit per IP
AGENT_RATE_PER_MIN=10     # pertanyaan agen per menit per IP
AGENT_DAILY_LIMIT=300     # pertanyaan ber-LLM per 24 jam untuk semua pengguna; lewat = mode hemat. 0 = tanpa batas

# Server MLflow untuk eksperimen model (lihat notebooks/)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Agen Tanya (Gemini, https://aistudio.google.com/apikey). Kosong = chat dimatikan, dasbor tetap jalan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite   # berurutan, kalau model utama kena 429/503

# Vector DB untuk RAG panduan (service qdrant di docker-compose). Embedding lokal, tanpa kunci.
QDRANT_URL=http://127.0.0.1:6333
# Model embedding dense. Ganti model → sesuaikan EMBED_DIM lalu bangun ulang koleksi: python -m pipeline.run knowledge
# (untuk Vercel: jalankan dengan kredensial Qdrant Cloud; model harus tersedia di Qdrant Cloud Inference).
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
# Awalan teks khusus model; tidak diisi = otomatis (e5: "query: "/"passage: ", model lain tanpa awalan).
# EMBED_QUERY_PREFIX="query: "
# EMBED_DOC_PREFIX="passage: "

# Akses tim lewat Cloudflare Tunnel (docker compose --profile public up -d tunnel).
# Password kosong = dasbor tanpa login (aman hanya untuk localhost). Isi sebelum membuka tunnel.
BASIC_AUTH_USER=tim
BASIC_AUTH_PASSWORD=

# ---- Produksi gratis (Vercel + Supabase + Qdrant Cloud + GitHub Actions), lihat README "Deploy" ----
# Supabase (Connect → Connection string). Session pooler untuk migrasi & GitHub Actions,
# transaction pooler (port 6543) untuk Vercel.
SUPABASE_SESSION_URL=
SUPABASE_TRANSACTION_URL=
# Qdrant Cloud (endpoint REST + API key). Di Vercel: QDRANT_URL/QDRANT_API_KEY + QDRANT_CLOUD_INFERENCE=true
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
# Fine-grained PAT GitHub (repo SIAGA-NUSA saja, izin Actions: read & write) yang dipakai pg_cron
# Supabase untuk memicu workflow tepat waktu. Dipasang lewat scripts/setup_supabase_cron.py.
GITHUB_DISPATCH_TOKEN=
